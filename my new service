private void syncActions(ResourceType dbResourceType, ResourceTypeDTO request) {

    Map<Integer, ResourceTypeAction> dbActionMap =
            dbResourceType.getResourceTypeActions().stream()
                    .collect(Collectors.toMap(
                            ResourceTypeAction::getId,
                            Function.identity(),
                            (a, b) -> a
                    ));

    List<ResourceTypeActionDTO> incomingActions =
            request.getResourceTypeActions().stream().toList();

    Set<Integer> processedActionIds = new HashSet<>();

    for (ResourceTypeActionDTO a : incomingActions) {

        if (a.getActionId() != null) {
            ResourceTypeAction action = dbActionMap.get(a.getActionId());

            if (action == null) {
                throw new PolicyAdministrationPointServiceException(
                        "Action not found",
                        "ACTION_NOT_FOUND",
                        HttpStatus.NOT_FOUND,
                        a.getActionId()
                );
            }

            action.setName(a.getName());
            action.setDescription(a.getDescription());
            action.setVisibility(ResourceTypeActionVisibility.valueOf(a.getVisibility()));

            processedActionIds.add(action.getId());

        } else {
            ResourceTypeAction newAction =
                    resourceTypeActionMapper
                            .resourceTypeActionDTOToResourceTypeActionEntity(a, dbResourceType);

            resourceTypeActionRepository.save(newAction);
        }
    }

    List<ResourceTypeAction> toDelete =
            dbResourceType.getResourceTypeActions().stream()
                    .filter(a -> !processedActionIds.contains(a.getId()))
                    .toList();

    if (!toDelete.isEmpty()) {
        resourceTypeActionRepository.deleteAll(toDelete);
    }
}


