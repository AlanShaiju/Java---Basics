private void syncR2RRelations(ResourceType dbResourceType, ResourceTypeDTO request) {

    Map<Integer, R2RRelation> dbR2RRelationMap =
            Stream.concat(
                    dbResourceType.getSourceR2RRelations().stream(),
                    dbResourceType.getTargetR2RRelations().stream()
            ).collect(Collectors.toMap(
                    R2RRelation::getId,
                    Function.identity(),
                    (a, b) -> a
            ));

    List<R2RRelationDTO> incomingR2RRelations =
            request.getR2RRelations().stream().toList();

    Set<Integer> processedR2RRelationIds = new HashSet<>();

    for (R2RRelationDTO r : incomingR2RRelations) {

        if (r.getRelationId() != null) {
            R2RRelation relation = dbR2RRelationMap.get(r.getRelationId());

            if (relation == null) {
                throw new PolicyAdministrationPointServiceException(
                        "R2R relation not found",
                        "R2R_NOT_FOUND",
                        HttpStatus.NOT_FOUND,
                        r.getRelationId()
                );
            }

            relation.setRelation(r.getRelationName());
            relation.setDescription(r.getDescription());

            processedR2RRelationIds.add(relation.getId());

        } else {
            ResourceType target =
                    resourceTypeRepository.getReferenceById(
                            r.getResourceTypeDetail().getResourceTypeId()
                    );

            R2RRelation newRelation;

            if (r.getIsSource()) {
                newRelation = r2RRelationMapper.createR2RRelationEntity(r, dbResourceType, target);
            } else {
                newRelation = r2RRelationMapper.createR2RRelationEntity(r, target, dbResourceType);
            }

            r2RRelationRepository.save(newRelation);
        }
    }

    List<R2RRelation> toDelete =
            dbR2RRelationMap.values().stream()
                    .filter(r -> !processedR2RRelationIds.contains(r.getId()))
                    .toList();

    if (!toDelete.isEmpty()) {
        r2RRelationRepository.deleteAll(toDelete);
    }
}
