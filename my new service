private void syncR2RRelations(ResourceType dbResourceType, ResourceTypeDTO request) {

    Map<Integer, R2RRelation> dbMap =
            Stream.concat(
                    dbResourceType.getSourceR2RRelations().stream(),
                    dbResourceType.getTargetR2RRelations().stream()
            ).collect(Collectors.toMap(R2RRelation::getId, Function.identity()));

    Set<Integer> incomingIds = new HashSet<>();

    for (R2RRelationDTO dto : request.getR2RRelations()) {

        if (dto.getRelationId() != null) {
            R2RRelation entity = dbMap.get(dto.getRelationId());

            if (entity == null) {
                throw new PolicyAdministrationPointServiceException(
                        "R2R relation not found", "R2R_NOT_FOUND",
                        HttpStatus.NOT_FOUND, dto.getRelationId()
                );
            }

            entity.setRelation(dto.getRelationName());
            entity.setDescription(dto.getDescription());

            incomingIds.add(entity.getId());

        } else {
            ResourceType target =
                    resourceTypeRepository.getReferenceById(
                            dto.getResourceTypeDetail().getResourceTypeId()
                    );

            R2RRelation newRelation;

            if (dto.getIsSource()) {
                newRelation = r2RRelationMapper.createR2RRelationEntity(dto, dbResourceType, target);
                dbResourceType.getSourceR2RRelations().add(newRelation);
            } else {
                newRelation = r2RRelationMapper.createR2RRelationEntity(dto, target, dbResourceType);
                dbResourceType.getTargetR2RRelations().add(newRelation);
            }
        }
    }

    // 🔥 remove deleted from BOTH sides
    dbResourceType.getSourceR2RRelations()
            .removeIf(r -> !incomingIds.contains(r.getId()));

    dbResourceType.getTargetR2RRelations()
            .removeIf(r -> !incomingIds.contains(r.getId()));
}
