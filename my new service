private void syncActions(ResourceType dbResourceType, Set<ResourceTypeActionDTO> requestActions) {

    if (requestActions == null) {
        requestActions = Collections.emptySet();
    }

    Set<ResourceTypeAction> existingActions = dbResourceType.getResourceTypeActions();

    Map<Integer, ResourceTypeAction> existingMap = existingActions.stream()
            .filter(a -> a.getId() != null)
            .collect(Collectors.toMap(ResourceTypeAction::getId, Function.identity()));

    Map<Integer, ResourceTypeActionDTO> requestMap = requestActions.stream()
            .filter(a -> a.getActionId() != null)
            .collect(Collectors.toMap(ResourceTypeActionDTO::getActionId, Function.identity()));

    // 🔥 DELETE
    existingActions.removeIf(existing ->
            existing.getId() != null && !requestMap.containsKey(existing.getId())
    );

    // 🔥 UPDATE
    for (ResourceTypeActionDTO dto : requestActions) {
        if (dto.getActionId() != null) {

            ResourceTypeAction existing = existingMap.get(dto.getActionId());

            if (existing == null) {
                throw new RuntimeException("Action not found: " + dto.getActionId());
            }

            existing.setName(dto.getActionName());
            existing.setDescription(dto.getDescription());
            existing.setVisibility(dto.getVisibility());
        }
    }

    // 🔥 CREATE
    for (ResourceTypeActionDTO dto : requestActions) {
        if (dto.getActionId() == null) {

            ResourceTypeAction newAction = new ResourceTypeAction();
            newAction.setName(dto.getActionName());
            newAction.setDescription(dto.getDescription());
            newAction.setVisibility(dto.getVisibility());

            newAction.setResourceType(dbResourceType);
            dbResourceType.getResourceTypeActions().add(newAction);
        }
    }
}




private void syncU2RRelations(ResourceType dbResourceType, Set<U2RRelationDTO> requestRelations) {

    if (requestRelations == null) {
        requestRelations = Collections.emptySet();
    }

    Set<U2RRelation> existingRelations = dbResourceType.getU2RRelations();

    Map<Integer, U2RRelation> existingMap = existingRelations.stream()
            .filter(r -> r.getId() != null)
            .collect(Collectors.toMap(U2RRelation::getId, Function.identity()));

    Map<Integer, U2RRelationDTO> requestMap = requestRelations.stream()
            .filter(r -> r.getRelationId() != null)
            .collect(Collectors.toMap(U2RRelationDTO::getRelationId, Function.identity()));

    // 🔥 DELETE
    existingRelations.removeIf(existing ->
            existing.getId() != null && !requestMap.containsKey(existing.getId())
    );

    // 🔥 UPDATE
    for (U2RRelationDTO dto : requestRelations) {

        if (dto.getRelationId() != null) {

            U2RRelation existing = existingMap.get(dto.getRelationId());

            if (existing == null) {
                throw new RuntimeException("U2RRelation not found: " + dto.getRelationId());
            }

            existing.setRelation(dto.getRelationName());
            existing.setDescription(dto.getDescription());
            existing.setVisibility(dto.getVisibility());

            // 🔥 Sync actions inside U2R
            syncU2RRelationActions(existing, dto.getActions());
        }
    }

    // 🔥 CREATE
    for (U2RRelationDTO dto : requestRelations) {

        if (dto.getRelationId() == null) {

            U2RRelation newRelation = new U2RRelation();
            newRelation.setRelation(dto.getRelationName());
            newRelation.setDescription(dto.getDescription());
            newRelation.setVisibility(dto.getVisibility());

            newRelation.setResourceType(dbResourceType);
            dbResourceType.getU2RRelations().add(newRelation);

            // 🔥 Sync actions
            syncU2RRelationActions(newRelation, dto.getActions());
        }
    }
}


private void syncU2RRelationActions(U2RRelation relation, Set<ResourceTypeActionDTO> actionDTOs) {

    if (actionDTOs == null) {
        actionDTOs = Collections.emptySet();
    }

    Set<U2RRelationActionMapping> existingMappings = relation.getRelationActions();

    Map<Integer, U2RRelationActionMapping> existingMap = existingMappings.stream()
            .filter(m -> m.getAction().getId() != null)
            .collect(Collectors.toMap(m -> m.getAction().getId(), Function.identity()));

    Set<Integer> requestActionIds = actionDTOs.stream()
            .filter(a -> a.getActionId() != null)
            .map(ResourceTypeActionDTO::getActionId)
            .collect(Collectors.toSet());

    // 🔥 DELETE
    existingMappings.removeIf(mapping ->
            mapping.getAction().getId() != null &&
            !requestActionIds.contains(mapping.getAction().getId())
    );

    // 🔥 CREATE (no update needed here usually)
    for (ResourceTypeActionDTO dto : actionDTOs) {

        if (dto.getActionId() != null && !existingMap.containsKey(dto.getActionId())) {

            ResourceTypeAction action = getAction(dto.getActionId());

            U2RRelationActionMapping mapping = new U2RRelationActionMapping();
            mapping.setRelation(relation);
            mapping.setAction(action);

            relation.getRelationActions().add(mapping);
        }
    }
}

private void syncR2RRelations(ResourceType dbResourceType, Set<R2RRelationDTO> requestRelations) {

    if (requestRelations == null) {
        requestRelations = Collections.emptySet();
    }

    Set<R2RRelation> existingRelations = Stream.concat(
            dbResourceType.getSourceR2RRelations().stream(),
            dbResourceType.getTargetR2RRelations().stream()
    ).collect(Collectors.toSet());

    Map<Integer, R2RRelation> existingMap = existingRelations.stream()
            .filter(r -> r.getId() != null)
            .collect(Collectors.toMap(R2RRelation::getId, Function.identity()));

    Map<Integer, R2RRelationDTO> requestMap = requestRelations.stream()
            .filter(r -> r.getRelationId() != null)
            .collect(Collectors.toMap(R2RRelationDTO::getRelationId, Function.identity()));

    // 🔥 DELETE
    for (R2RRelation existing : new HashSet<>(existingRelations)) {

        if (existing.getId() != null && !requestMap.containsKey(existing.getId())) {

            existing.getSourceResourceType().getSourceR2RRelations().remove(existing);
            existing.getTargetResourceType().getTargetR2RRelations().remove(existing);
        }
    }

    // 🔥 UPDATE
    for (R2RRelationDTO dto : requestRelations) {

        if (dto.getRelationId() != null) {

            R2RRelation existing = existingMap.get(dto.getRelationId());

            if (existing == null) {
                throw new RuntimeException("R2RRelation not found: " + dto.getRelationId());
            }

            existing.setRelation(dto.getRelationName());
            existing.setDescription(dto.getDescription());

            Integer sourceId = dto.getIsSource()
                    ? dbResourceType.getId()
                    : dto.getResourceTypeDetails().getResourceTypeId();

            Integer targetId = dto.getIsSource()
                    ? dto.getResourceTypeDetails().getResourceTypeId()
                    : dbResourceType.getId();

            ResourceType newSource = getResourceType(sourceId);
            ResourceType newTarget = getResourceType(targetId);

            if (!existing.getSourceResourceType().getId().equals(newSource.getId())) {
                existing.getSourceResourceType().getSourceR2RRelations().remove(existing);
                newSource.getSourceR2RRelations().add(existing);
                existing.setSourceResourceType(newSource);
            }

            if (!existing.getTargetResourceType().getId().equals(newTarget.getId())) {
                existing.getTargetResourceType().getTargetR2RRelations().remove(existing);
                newTarget.getTargetR2RRelations().add(existing);
                existing.setTargetResourceType(newTarget);
            }
        }
    }

    // 🔥 CREATE
    for (R2RRelationDTO dto : requestRelations) {

        if (dto.getRelationId() == null) {

            R2RRelation newRelation = new R2RRelation();
            newRelation.setRelation(dto.getRelationName());
            newRelation.setDescription(dto.getDescription());

            Integer sourceId = dto.getIsSource()
                    ? dbResourceType.getId()
                    : dto.getResourceTypeDetails().getResourceTypeId();

            Integer targetId = dto.getIsSource()
                    ? dto.getResourceTypeDetails().getResourceTypeId()
                    : dbResourceType.getId();

            ResourceType source = getResourceType(sourceId);
            ResourceType target = getResourceType(targetId);

            newRelation.setSourceResourceType(source);
            newRelation.setTargetResourceType(target);

            source.getSourceR2RRelations().add(newRelation);
            target.getTargetR2RRelations().add(newRelation);
        }
    }
}
