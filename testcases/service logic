private void updateRelations(Set<R2RRelationDTO> requestRelations,
                             Map<Integer, R2RRelation> existingMap,
                             ResourceType dbResourceType) {
    for (R2RRelationDTO dto : requestRelations) {
        if (isExistingRelation(dto)) {
            R2RRelation existing = getExistingOrThrow(dto, existingMap);
            updateBasicFields(existing, dto);
            ResourceType newSource = resolveSource(dto, dbResourceType);
            ResourceType newTarget = resolveTarget(dto, dbResourceType);
            updateSourceIfChanged(existing, newSource);
            updateTargetIfChanged(existing, newTarget);
        }
    }
}

private boolean isExistingRelation(R2RRelationDTO dto) {
    return dto.getRelationId() != null;
}

private R2RRelation getExistingOrThrow(R2RRelationDTO dto,
                                       Map<Integer, R2RRelation> existingMap) {
    R2RRelation existing = existingMap.get(dto.getRelationId());
    if (existing == null) {
        throw new PolicyAdministrationPointServiceException(
                "R2RRelation not found",
                "R2R_RELATION_ACTION_NOT_FOUND",
                HttpStatus.NOT_FOUND,
                dto.getRelationId()
        );
    }
    return existing;
}


private void updateBasicFields(R2RRelation existing, R2RRelationDTO dto) {
    existing.setRelation(dto.getRelationName());
    existing.setDescription(dto.getDescription());
}

private ResourceType resolveSource(R2RRelationDTO dto,
                                   ResourceType dbResourceType) {
    Integer sourceId = dto.getIsSource()
            ? dbResourceType.getId()
            : dto.getResourceTypeDetail().getResourceTypeId();
    return resourceTypeRepository.findById(sourceId)
            .orElseThrow(() -> new PolicyAdministrationPointServiceException(
                    "Source ResourceType not found",
                    "RESOURCE_TYPE_NOT_FOUND",
                    HttpStatus.NOT_FOUND,
                    sourceId
            ));
}

private ResourceType resolveTarget(R2RRelationDTO dto,
                                   ResourceType dbResourceType) {
    Integer targetId = dto.getIsSource()
            ? dto.getResourceTypeDetail().getResourceTypeId()
            : dbResourceType.getId();
    return resourceTypeRepository.findById(targetId)
            .orElseThrow(() -> new PolicyAdministrationPointServiceException(
                    "Target ResourceType not found",
                    "RESOURCE_TYPE_NOT_FOUND",
                    HttpStatus.NOT_FOUND,
                    targetId
            ));
}

private void updateSourceIfChanged(R2RRelation existing, ResourceType newSource) {

    if (!existing.getSourceResourceType().getId().equals(newSource.getId())) {

        existing.getSourceResourceType().getSourceR2RRelations().remove(existing);
        newSource.getSourceR2RRelations().add(existing);
        existing.setSourceResourceType(newSource);
    }
}

private void updateTargetIfChanged(R2RRelation existing, ResourceType newTarget) {

    if (!existing.getTargetResourceType().getId().equals(newTarget.getId())) {

        existing.getTargetResourceType().getTargetR2RRelations().remove(existing);
        newTarget.getTargetR2RRelations().add(existing);
        existing.setTargetResourceType(newTarget);
    }
}
