    service.syncActions(db, null);
}

@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("syncActions should update existing action")
@Test
void syncActions_shouldUpdateExistingAction() {
    ResourceType db = new ResourceType();

    ResourceTypeAction existing = new ResourceTypeAction();
    existing.setId(1);
    existing.setName("old");
    existing.setDescription("old");

    db.setResourceTypeActions(new HashSet<>(Set.of(existing)));

    ResourceTypeActionDTO dto = new ResourceTypeActionDTO();
    dto.setActionId(1);
    dto.setName("new");
    dto.setDescription("new");
    dto.setVisibility("PUBLIC");

    service.syncActions(db, Set.of(dto));

    assertEquals("new", existing.getName());
    assertEquals("new", existing.getDescription());
}

@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("syncActions should throw when action not found")
@Test
void syncActions_shouldThrowWhenActionNotFound() {
    ResourceType db = new ResourceType();
    db.setResourceTypeActions(new HashSet<>());

    ResourceTypeActionDTO dto = new ResourceTypeActionDTO();
    dto.setActionId(99);

    assertThrows(PolicyAdministrationPointServiceException.class,
            () -> service.syncActions(db, Set.of(dto)));
}

