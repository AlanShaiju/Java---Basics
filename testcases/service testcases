@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("removeDeletedRelations should remove missing relations")
@Test
void removeDeletedRelations_shouldRemoveRelation() {
    ResourceType source = new ResourceType();
    source.setSourceR2RRelations(new HashSet<>());

    ResourceType target = new ResourceType();
    target.setTargetR2RRelations(new HashSet<>());

    R2RRelation relation = new R2RRelation();
    relation.setId(1);
    relation.setSourceResourceType(source);
    relation.setTargetResourceType(target);

    source.getSourceR2RRelations().add(relation);
    target.getTargetR2RRelations().add(relation);

    Set<R2RRelation> existing = new HashSet<>(Set.of(relation));
    Map<Integer, R2RRelationDTO> requestMap = Map.of(); // empty → delete

    resourceTypeService.removeDeletedRelations(existing, requestMap);

    assertThat(source.getSourceR2RRelations()).isEmpty();
}


@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("createRelations should create new relation when id is null")
@Test
void createRelations_shouldCreateRelation() {
    ResourceType db = new ResourceType();
    db.setId(1);
    db.setSourceR2RRelations(new HashSet<>());
    db.setTargetR2RRelations(new HashSet<>());

    ResourceType other = new ResourceType();
    other.setId(2);
    other.setSourceR2RRelations(new HashSet<>());
    other.setTargetR2RRelations(new HashSet<>());

    ResourceTypeDetail detail = new ResourceTypeDetail();
    detail.setResourceTypeId(2);

    R2RRelationDTO dto = new R2RRelationDTO();
    dto.setRelationName("REL");
    dto.setDescription("DESC");
    dto.setIsSource(true);
    dto.setResourceTypeDetail(detail);

    when(resourceTypeRepository.findById(anyInt()))
            .thenReturn(Optional.of(other));

    resourceTypeService.createRelations(Set.of(dto), db);

    assertThat(db.getSourceR2RRelations()).isNotEmpty();
}
