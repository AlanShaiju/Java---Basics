@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("updateTargetIfChanged should update target relation")
@Test
void updateTargetIfChanged_shouldUpdateTargetRelation() {
    ResourceType oldTarget = new ResourceType();
    oldTarget.setId(1);
    oldTarget.setTargetR2RRelations(new HashSet<>());

    ResourceType newTarget = new ResourceType();
    newTarget.setId(2);
    newTarget.setTargetR2RRelations(new HashSet<>());

    R2RRelation relation = new R2RRelation();
    relation.setTargetResourceType(oldTarget);
    oldTarget.getTargetR2RRelations().add(relation);

    service.updateTargetIfChanged(relation, newTarget);

    assertEquals(newTarget, relation.getTargetResourceType());
}

