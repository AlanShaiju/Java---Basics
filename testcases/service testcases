@Test
@DisplayName("updateResourceType should throw exception when topic not found")
void updateResourceType_topicNotFound_shouldThrowException() {
    when(resourceTypeRepository.findById(anyInt()))
            .thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
    when(topicRepository.findById(anyInt()))
            .thenReturn(Optional.empty());
    assertThrows(
            PolicyAdministrationPointServiceException.class,
            () -> resourceTypeService.updateResourceType(
                    1,
                    RESOURCE_TYPE_WITH_VALID_INPUT_2
            )
    );
}


@Test
@DisplayName("updateResourceType should throw exception when u2r integrity fails")
void updateResourceType_u2rIntegrityFails_shouldThrowException() {
    when(resourceTypeRepository.findById(anyInt()))
            .thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
    when(topicRepository.findById(anyInt()))
            .thenReturn(Optional.ofNullable(MOCK_TOPIC));
    doThrow(new PolicyAdministrationPointServiceException(
            "U2R integrity failed", "", HttpStatus.BAD_REQUEST
    )).when(resourceTypeService).u2RRelationIntegrityCheck(any(), any());
    assertThrows(
            PolicyAdministrationPointServiceException.class,
            () -> resourceTypeService.updateResourceType(
                    1,
                    RESOURCE_TYPE_WITH_VALID_INPUT_2
            )
    );
}


