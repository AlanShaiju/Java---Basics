@Test
@DisplayName("updateResourceType should update successfully")
void updateResourceType_withValidInput_shouldReturnUpdatedResponse() {
    Integer resourceTypeId = 1;
    when(resourceTypeRepository.findById(resourceTypeId))
            .thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
    when(topicRepository.findById(anyInt()))
            .thenReturn(Optional.ofNullable(MOCK_TOPIC));
    when(resourceTypeRepository.save(any()))
            .thenReturn(MOCK_RESOURCE_TYPE);
    when(resourceTypeMapper.toDTO(any(), any(), any(), any(), any()))
            .thenReturn(RESOURCE_TYPE_VALID_RESPONSE);
    ResourceTypeDTO result = resourceTypeService.updateResourceType(
            resourceTypeId,
            RESOURCE_TYPE_WITH_VALID_INPUT_2
    );
    assertThat(result).isNotNull();
    assertThat(result.getResourceTypeId())
            .isEqualTo(RESOURCE_TYPE_VALID_RESPONSE.getResourceTypeId());
}

