@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("syncActions should remove missing actions")
@Test
void syncActions_shouldRemoveMissingActions() {
    ResourceType db = new ResourceType();

    ResourceTypeAction a1 = new ResourceTypeAction();
    a1.setId(1);

    ResourceTypeAction a2 = new ResourceTypeAction();
    a2.setId(2);

    db.setResourceTypeActions(new HashSet<>(Set.of(a1, a2)));

    ResourceTypeActionDTO dto = new ResourceTypeActionDTO();
    dto.setActionId(1);

    service.syncActions(db, Set.of(dto));

    assertEquals(1, db.getResourceTypeActions().size());
}