@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("syncU2RRelations should update existing relation")
@Test
void syncU2RRelations_shouldUpdateExistingRelation() {
    ResourceType db = new ResourceType();

    U2RRelation existing = new U2RRelation();
    existing.setId(1);
    existing.setRelation("old");
    existing.setDescription("old");

    db.setU2RRelations(new HashSet<>(Set.of(existing)));

    U2RRelationDTO dto = new U2RRelationDTO();
    dto.setRelationId(1);
    dto.setRelationName("new");
    dto.setDescription("new");
    dto.setVisibility("PUBLIC");
    dto.setU2RRelationActions(new HashSet<>());

    service.syncU2RRelations(db, Set.of(dto));

    assertEquals("new", existing.getRelation());
    assertEquals("new", existing.getDescription());
}

@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("syncU2RRelations should throw when existing relation not found")
@Test
void syncU2RRelations_shouldThrowWhenRelationNotFound() {
    ResourceType db = new ResourceType();
    db.setU2RRelations(new HashSet<>());

    U2RRelationDTO dto = new U2RRelationDTO();
    dto.setRelationId(99);

    assertThrows(PolicyAdministrationPointServiceException.class,
            () -> service.syncU2RRelations(db, Set.of(dto)));
}

