    db.setResourceTypeConfigs(new HashSet<>(Set.of(config)));

    ResourceTypeDTO dto = new ResourceTypeDTO();
    dto.setIsUserGroupInstanceAllowed(true);

    service.syncResourceTypeConfigs(db, dto);

    assertEquals("true", config.getValue());
}

