@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("createRelations should create new relation")
@Test
void createRelations_shouldCreateNewRelation() {
    ResourceType db = new ResourceType();
    db.setId(1);
    db.setSourceR2RRelations(new HashSet<>());
    db.setTargetR2RRelations(new HashSet<>());

    ResourceType target = new ResourceType();
    target.setId(2);
    target.setSourceR2RRelations(new HashSet<>());
    target.setTargetR2RRelations(new HashSet<>());

    when(resourceTypeRepository.findById(2))
            .thenReturn(Optional.of(target));

    R2RRelationDTO dto = new R2RRelationDTO();
    dto.setRelationId(null);
    dto.setIsSource(true);

    ResourceTypeDetail detail = new ResourceTypeDetail();
    detail.setResourceTypeId(2);
    dto.setResourceTypeDetail(detail);

    service.createRelations(Set.of(dto), db);

    assertFalse(db.getSourceR2RRelations().isEmpty());
}
