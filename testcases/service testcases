@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("syncU2RRelations should remove relations not present in request")
@Test
void syncU2RRelations_shouldRemoveDeletedRelations() {
    ResourceType db = new ResourceType();

    U2RRelation existing1 = new U2RRelation();
    existing1.setId(1);

    U2RRelation existing2 = new U2RRelation();
    existing2.setId(2);

    db.setU2RRelations(new HashSet<>(Set.of(existing1, existing2)));

    U2RRelationDTO dto = new U2RRelationDTO();
    dto.setRelationId(1);

    service.syncU2RRelations(db, Set.of(dto));

    assertEquals(1, db.getU2RRelations().size());
}