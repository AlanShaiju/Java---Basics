@ExtendWith(MockitoExtension.class)
class STLResourceTypeManagementServiceTest {

    @Spy
    @InjectMocks
    private STLResourceTypeManagementServiceImpl resourceTypeService;

    @Mock
    private ResourceTypeRepository resourceTypeRepository;

    @Mock
    private TopicRepository topicRepository;

    @Mock
    private ResourceTypeMapper resourceTypeMapper;


    // =======================
    // COMMON MOCK HELPER
    // =======================
    private void mockInternalMethods() {
        doNothing().when(resourceTypeService).syncActions(any(), any());
        doNothing().when(resourceTypeService).syncU2RRelations(any(), any());
        doNothing().when(resourceTypeService).syncR2RRelations(any(), any());
        doNothing().when(resourceTypeService).syncResourceTypeConfigs(any(), any());
        doNothing().when(resourceTypeService).u2RRelationIntegrityCheck(any(), any());
        doNothing().when(resourceTypeService).r2RRelationIntegrityCheck(any());
    }


    // =======================
    // TEST CASES
    // =======================

    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should return updated response for valid input")
    @Test
    void updateResourceType_withValidInput_shouldReturnUpdatedResponse() {
        mockInternalMethods();
        when(resourceTypeRepository.findById(anyInt())).thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
        when(topicRepository.findById(anyInt())).thenReturn(Optional.ofNullable(MOCK_TOPIC));
        when(resourceTypeRepository.save(any())).thenReturn(MOCK_RESOURCE_TYPE);
        when(resourceTypeMapper.toDTO(any(), any(), any(), any(), any())).thenReturn(RESOURCE_TYPE_VALID_RESPONSE);
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        ResourceTypeDTO result = resourceTypeService.updateResourceType(1, request);
        assertThat(result).isNotNull();
        assertThat(result.getResourceTypeId()).isEqualTo(RESOURCE_TYPE_VALID_RESPONSE.getResourceTypeId());
    }


    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should throw exception when path id and body id mismatch")
    @Test
    void updateResourceType_idMismatch_shouldThrowException() {
        Integer pathId = 1;
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        request.setResourceTypeId(2);
        assertThrows(PolicyAdministrationPointServiceException.class,
                () -> resourceTypeService.updateResourceType(pathId, request));
    }


    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should throw exception when resource type not found")
    @Test
    void updateResourceType_resourceNotFound_shouldThrowException() {
        when(resourceTypeRepository.findById(anyInt())).thenReturn(Optional.empty());
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        assertThrows(PolicyAdministrationPointServiceException.class,
                () -> resourceTypeService.updateResourceType(1, request));
    }


    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should throw exception when topic not found")
    @Test
    void updateResourceType_topicNotFound_shouldThrowException() {
        when(resourceTypeRepository.findById(anyInt())).thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
        when(topicRepository.findById(anyInt())).thenReturn(Optional.empty());
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        assertThrows(PolicyAdministrationPointServiceException.class,
                () -> resourceTypeService.updateResourceType(1, request));
    }


    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should throw exception when u2r integrity fails")
    @Test
    void updateResourceType_u2rIntegrityFails_shouldThrowException() {
        mockInternalMethods();
        when(resourceTypeRepository.findById(anyInt())).thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
        when(topicRepository.findById(anyInt())).thenReturn(Optional.ofNullable(MOCK_TOPIC));
        doThrow(new PolicyAdministrationPointServiceException("U2R integrity failed","",HttpStatus.BAD_REQUEST))
                .when(resourceTypeService).u2RRelationIntegrityCheck(any(), any());
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        assertThrows(PolicyAdministrationPointServiceException.class,
                () -> resourceTypeService.updateResourceType(1, request));
    }


    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should delete missing r2r relations when not present in request")
    @Test
    void updateResourceType_shouldDeleteMissingRelations() {
        mockInternalMethods();
        when(resourceTypeRepository.findById(anyInt())).thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
        when(topicRepository.findById(anyInt())).thenReturn(Optional.ofNullable(MOCK_TOPIC));
        when(resourceTypeRepository.save(any())).thenReturn(MOCK_RESOURCE_TYPE);
        when(resourceTypeMapper.toDTO(any(), any(), any(), any(), any())).thenReturn(RESOURCE_TYPE_VALID_RESPONSE);
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        request.setR2RRelations(new HashSet<>());
        ResourceTypeDTO result = resourceTypeService.updateResourceType(1, request);
        assertThat(result).isNotNull();
    }


    @Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
    @DisplayName("updateResourceType should update config values based on request")
    @Test
    void updateResourceType_shouldUpdateConfigs() {
        mockInternalMethods();
        ResourceTypeConfig c1 = new ResourceTypeConfig();
        c1.setKey("USER_GROUP_INSTANCE_ALLOWED");
        c1.setValue("false");
        ResourceTypeConfig c2 = new ResourceTypeConfig();
        c2.setKey("HROLE_ALLOWED");
        c2.setValue("false");
        MOCK_RESOURCE_TYPE.setResourceTypeConfigs(Set.of(c1, c2));
        when(resourceTypeRepository.findById(anyInt())).thenReturn(Optional.of(MOCK_RESOURCE_TYPE));
        when(topicRepository.findById(anyInt())).thenReturn(Optional.ofNullable(MOCK_TOPIC));
        when(resourceTypeRepository.save(any())).thenReturn(MOCK_RESOURCE_TYPE);
        when(resourceTypeMapper.toDTO(any(), any(), any(), any(), any())).thenReturn(RESOURCE_TYPE_VALID_RESPONSE);
        ResourceTypeDTO request = new ResourceTypeDTO(RESOURCE_TYPE_VALID_UPDATE_REQUEST);
        request.setIsUserGroupInstanceAllowed(true);
        request.setIsHRoleAllowed(true);
        ResourceTypeDTO result = resourceTypeService.updateResourceType(1, request);
        assertThat(result).isNotNull();
    }
}
