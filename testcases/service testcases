@Tag("STLResourceTypeManagementServiceImpl_Test_Cases")
@DisplayName("updateSourceIfChanged should update source relation")
@Test
void updateSourceIfChanged_shouldUpdateSource() {
    ResourceType oldSource = new ResourceType();
    oldSource.setId(1);
    oldSource.setSourceR2RRelations(new HashSet<>());

    ResourceType newSource = new ResourceType();
    newSource.setId(2);
    newSource.setSourceR2RRelations(new HashSet<>());

    R2RRelation relation = new R2RRelation();
    relation.setSourceResourceType(oldSource);

    oldSource.getSourceR2RRelations().add(relation);

    resourceTypeService.updateSourceIfChanged(relation, newSource);

    assertThat(relation.getSourceResourceType()).isEqualTo(newSource);
}


